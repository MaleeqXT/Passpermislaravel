APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug


DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=permis_facile_db
DB_USERNAME=default
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=passpermis-local
REVERB_APP_KEY=replace-with-a-random-app-key
REVERB_APP_SECRET=replace-with-a-random-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


VITE_STRIP_PUBLISHABLE=your-stripe-publishable-key
STRIPE_SECRET_KEY=

PAYPAL_MODE=sandbox
#Paypal sandbox credential
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=

REQUEST_SLOW=1

BUGSNAG_API_KEY=
BUGSNAG_ENABLED=false

# French Ministry RdvPermis / Livret Numérique (RECETTE1 by default).
# Keep secrets only in the deployment environment; never expose them to Vite.
# Environment labels do not select URLs; set all URLs explicitly for each deployment.
RDVPERMIS_ENV=recette1
RDVPERMIS_CLIENT_ID=your-rdvpermis-client-id
RDVPERMIS_CLIENT_SECRET=
RDVPERMIS_AUTH_URL=https://recette.moncompte.permisdeconduire.gouv.fr/auth/realms/formation/protocol/openid-connect/auth
RDVPERMIS_TOKEN_URL=https://recette.moncompte.permisdeconduire.gouv.fr/auth/realms/formation/protocol/openid-connect/token
RDVPERMIS_API_URL=https://api.integediteurs.rdv-permis.interieur.gouv.fr
# Must exactly match the callback URL registered by RDVPermis.
RDVPERMIS_REDIRECT_URI=
RDVPERMIS_FRONTEND_CALLBACK_URL=
RDVPERMIS_SCOPES="rdvpermis livret_numerique:read livret_numerique:write offline_access"
RDVPERMIS_TIMEOUT=20
GOOGLE_REVIEW_URL=

# Optional shared cache store for refresh locks and cooldowns (defaults to CACHE_STORE).
RDVPERMIS_CACHE_STORE=
