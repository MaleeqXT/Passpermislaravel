{
  "info": {
    "_postman_id": "72ccf766-723d-48dd-95cd-06fbcffcd721",
    "name": "RDVPermis Auto-Ecole - RECETTE1",
    "description": "Minimal RECETTE1 client-credentials checks. Keep client_secret in a private Postman environment and never commit it.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "client_id",
      "value": "ef4a4dd3-ff91-4ff1-9cdf-961ad464c655",
      "type": "string"
    },
    {
      "key": "client_secret",
      "value": "",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Get Access Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Token endpoint returned HTTP 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "let payload = {};",
              "try {",
              "    payload = pm.response.json();",
              "} catch (error) {",
              "    throw new Error(\"Token endpoint did not return JSON.\");",
              "}",
              "",
              "pm.test(\"Response contains an access token\", function () {",
              "    pm.expect(payload.access_token).to.be.a(\"string\").and.not.empty;",
              "});",
              "",
              "if (pm.response.code === 200 && payload.access_token) {",
              "    pm.environment.set(\"access_token\", payload.access_token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded",
            "type": "text"
          },
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials",
              "type": "text"
            },
            {
              "key": "client_id",
              "value": "{{client_id}}",
              "type": "text"
            },
            {
              "key": "client_secret",
              "value": "{{client_secret}}",
              "type": "text"
            },
            {
              "key": "scope",
              "value": "rdvpermis",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "https://recette.moncompte.permisdeconduire.gouv.fr/auth/realms/formation/protocol/openid-connect/token",
          "protocol": "https",
          "host": [
            "recette",
            "moncompte",
            "permisdeconduire",
            "gouv",
            "fr"
          ],
          "path": [
            "auth",
            "realms",
            "formation",
            "protocol",
            "openid-connect",
            "token"
          ]
        },
        "description": "Uses client_credentials only. No callback, redirect URI, authorization code, or browser redirect is involved.",
        "protocolProfileBehavior": {
          "followRedirects": false
        }
      },
      "response": []
    },
    {
